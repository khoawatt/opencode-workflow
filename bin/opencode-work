#!/usr/bin/env bash
set -Eeuo pipefail

SESSION="${OPENCODE_WORK_SESSION:-opencode-work}"
CONFIG_FILE="${OPENCODE_WORK_CONFIG:-$HOME/.config/opencode/projects.conf}"

# Default hardcoded projects (fallback if config not present — keeps backward compat)
DEFAULT_NAMES=("feaon" "qvak")
DEFAULT_URLS=("https://github.com/khoawatt/Feaon-ldp-v2.git" "https://github.com/khoawatt/qvak-portfolio.git")
DEFAULT_PATHS=("$HOME/projects/personal/Feaon-ldp-v2" "$HOME/projects/personal/qvak-portfolio")

# Dedicated local workspace: mặc định auto-approve các permission ở trạng thái ask.
OPENCODE_WORK_AUTO="${OPENCODE_WORK_AUTO:-1}"

die() {
    printf 'opencode-work: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: opencode-work [--reset|--status|--help]

  no argument  Create the configured tmux workspace, or attach to it.
  --reset      Recreate only the opencode-work tmux session.
  --status     Show configured projects and current session state.
  --help       Show this help.

Environment:
  OPENCODE_WORK_CONFIG   Override the project config path.
  OPENCODE_WORK_SESSION  Override the tmux session name.
  OPENCODE_WORK_AUTO     0 = manual permission, 1 = auto-approve (default).
EOF
}

expand_path() {
    local value="$1"
    case "$value" in
        '~') printf '%s\n' "$HOME" ;;
        '~/'*) printf '%s/%s\n' "$HOME" "${value:2}" ;;
        /*) printf '%s\n' "$value" ;;
        *) die "Checkout path must be absolute or start with ~/: $value" ;;
    esac
}

load_projects() {
    PROJECT_NAMES=()
    PROJECT_URLS=()
    PROJECT_PATHS=()

    if [[ -r "$CONFIG_FILE" ]]; then
        local line_number=0 name url checkout_path extra expanded_path
        while IFS='|' read -r name url checkout_path extra || [[ -n "${name}${url}${checkout_path}${extra}" ]]; do
            line_number=$((line_number + 1))
            [[ -z "${name//[[:space:]]/}" || "$name" == \#* ]] && continue

            [[ -n "$name" && -n "$url" && -n "$checkout_path" && -z "${extra:-}" ]] ||
                die "Invalid config at $CONFIG_FILE:$line_number (expected name|git_url|checkout_path)."
            [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] ||
                die "Invalid project name '$name' at $CONFIG_FILE:$line_number."

            expanded_path="$(expand_path "$checkout_path")"
            PROJECT_NAMES+=("$name")
            PROJECT_URLS+=("$url")
            PROJECT_PATHS+=("$expanded_path")
        done < "$CONFIG_FILE"

        ((${#PROJECT_NAMES[@]} > 0)) || die "No projects configured in $CONFIG_FILE."
    else
        # Fallback to hardcoded defaults (backward compat)
        PROJECT_NAMES=("${DEFAULT_NAMES[@]}")
        PROJECT_URLS=("${DEFAULT_URLS[@]}")
        PROJECT_PATHS=("${DEFAULT_PATHS[@]}")
    fi
}

require_runtime() {
    command -v tmux >/dev/null 2>&1 || die "tmux is not installed. See docs/SETUP.md."
    command -v opencode >/dev/null 2>&1 || die "OpenCode CLI is not installed or not in PATH. See docs/SETUP.md."

    local index
    for index in "${!PROJECT_PATHS[@]}"; do
        [[ -d "${PROJECT_PATHS[$index]}" ]] ||
            die "Project '${PROJECT_NAMES[$index]}' is missing: ${PROJECT_PATHS[$index]}. Run install.sh or clone it."
    done
}

attach_workspace() {
    if [[ -n "${TMUX:-}" ]]; then
        exec tmux switch-client -t "$SESSION"
    fi
    exec tmux attach-session -t "$SESSION"
}

session_is_valid() {
    local actual_paths expected_path pane_count
    pane_count="$(tmux list-panes -t "$SESSION" -F '#{pane_id}' 2>/dev/null | wc -l | tr -d ' ')"
    [[ "$pane_count" -eq "${#PROJECT_PATHS[@]}" ]] || return 1

    actual_paths="$(tmux list-panes -t "$SESSION" -F '#{pane_current_path}' 2>/dev/null)"
    for expected_path in "${PROJECT_PATHS[@]}"; do
        grep -Fxq "$expected_path" <<< "$actual_paths" || return 1
    done
}

show_status() {
    printf 'Config: %s\nSession: %s\nProjects:\n' "$CONFIG_FILE" "$SESSION"
    local index
    for index in "${!PROJECT_NAMES[@]}"; do
        printf '  - %s -> %s\n' "${PROJECT_NAMES[$index]}" "${PROJECT_PATHS[$index]}"
    done

    if command -v tmux >/dev/null 2>&1 && tmux has-session -t "$SESSION" 2>/dev/null; then
        printf 'State: running\n'
        tmux list-panes -t "$SESSION" -F '  #{pane_index}: #{pane_current_path} (#{pane_current_command})'
    else
        printf 'State: stopped\n'
    fi
}

# Validate OPENCODE_WORK_AUTO
case "$OPENCODE_WORK_AUTO" in
    0|1) ;;
    *) die "OPENCODE_WORK_AUTO chỉ nhận 0 hoặc 1." ;;
esac

OPENCODE_BIN="$(command -v opencode 2>/dev/null || echo opencode)"

[[ $# -le 1 ]] || die "Too many arguments. Use --help."
case "${1:-}" in
    ''|--reset|--status) ;;
    --help) usage; exit 0 ;;
    *) die "Unknown option: $1. Use --help." ;;
esac

load_projects

if [[ "${1:-}" == "--status" ]]; then
    show_status
    exit 0
fi

require_runtime

if [[ "${1:-}" == "--reset" ]] && tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux kill-session -t "$SESSION"
fi

if tmux has-session -t "$SESSION" 2>/dev/null; then
    session_is_valid || die "Session '$SESSION' does not match the config. Run opencode-work --reset."
    attach_workspace
fi

cleanup_failed_create() {
    local exit_code=$?
    trap - ERR
    tmux kill-session -t "$SESSION" 2>/dev/null || true
    exit "$exit_code"
}
trap cleanup_failed_create ERR

# Create workspace: first pane + split for remaining projects
FIRST_PANE="$(
    tmux new-session -d -s "$SESSION" -c "${PROJECT_PATHS[0]}" \
        -P -F '#{pane_id}' "exec $(printf '%q' "$OPENCODE_BIN") $([[ "$OPENCODE_WORK_AUTO" == "1" ]] && echo --auto) $(printf '%q' "${PROJECT_PATHS[0]}")"
)"
tmux select-pane -t "$FIRST_PANE" -T "${PROJECT_NAMES[0]}"

for ((index = 1; index < ${#PROJECT_NAMES[@]}; index++)); do
    pane_id="$(
        tmux split-window -d -t "$SESSION" -c "${PROJECT_PATHS[$index]}" \
            -P -F '#{pane_id}' "exec $(printf '%q' "$OPENCODE_BIN") $([[ "$OPENCODE_WORK_AUTO" == "1" ]] && echo --auto) $(printf '%q' "${PROJECT_PATHS[$index]}")"
    )"
    tmux select-pane -t "$pane_id" -T "${PROJECT_NAMES[$index]}"
done

if ((${#PROJECT_NAMES[@]} == 2)); then
    tmux select-layout -t "$SESSION" even-horizontal >/dev/null
else
    tmux select-layout -t "$SESSION" tiled >/dev/null
fi
tmux select-pane -t "$FIRST_PANE"

trap - ERR
attach_workspace
